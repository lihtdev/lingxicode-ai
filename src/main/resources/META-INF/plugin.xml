<idea-plugin>
    <id>com.lihtdev.lingxicode</id>
    <name>LingxiCode AI</name>
    <vendor email="lihaitao.me@qq.com">lihaitao</vendor><!-- 市场联系与审核通知用 -->
    <!-- 描述前 40+ 字符须为拉丁字符（Plugin Verifier 的 STARTS_WITH_LATIN_SYMBOLS_REGEX 校验），故英文简介在前 -->
    <description><![CDATA[LingxiCode AI - An AI toolkit for JetBrains IDEs. One-click AI commit message generation and more.<br/>
    灵犀码 — 面向开发者的 AI 能力集。<br/>
    当前功能：<br/>
    <ul>
        <li>AI 提交信息生成：在 Git 提交对话框一键根据代码变更生成 Conventional Commits 格式提交信息</li>
        <li>AI 代码解释：选中代码或将光标置于类/方法/函数内，一键生成结构化解释并弹出展示</li>
        <li>支持 OpenAI / DeepSeek / GLM / Kimi / MiniMax / Qwen / Xiaomi MIMO 等预设厂商及任意自定义 OpenAI 兼容端点</li>
    </ul>]]></description>

    <!-- 仅依赖平台模块，全系列 JetBrains IDE 可用 -->
    <depends>com.intellij.modules.platform</depends>

    <!-- 国际化资源束：下方 action 的 text/description 以键引用此束，随 IDE 语言切换 -->
    <resource-bundle>messages.LingxiCodeBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 应用级设置持久化 -->
        <applicationService serviceImplementation="com.lihtdev.lingxicode.settings.AppSettings"/>
        <!-- 国际化资源束 -->
        <applicationService serviceImplementation="com.lihtdev.lingxicode.i18n.LingxiCodeBundle"/>
        <!-- 设置页（Tools 下） -->
        <applicationConfigurable parentId="tools"
                                 id="lingxicode.settings"
                                 instance="com.lihtdev.lingxicode.settings.SettingsConfigurable"
                                 displayName="LingxiCode AI"
                                 icon="/icons/lingxicode.svg"/>
        <!-- 通知组 -->
        <notificationGroup id="LingxiCodeAI" displayType="BALLOON"/>
        <!-- 编辑器行号旁 gutter「解释代码」图标 -->
        <codeInsight.lineMarkerProvider
                implementationClass="com.lihtdev.lingxicode.action.ExplainCodeLineMarkerProvider"/>
        <!-- 状态栏模型切换器 -->
        <statusBarWidgetFactory id="lingxicode.modelSwitcher"
                                implementation="com.lihtdev.lingxicode.ui.ModelSwitcherWidgetFactory"
                                order="after Encoding"/>
    </extensions>

    <!-- 预留的 AI 功能扩展点：后续新功能（如代码解释）经此注册 -->
    <extensionPoints>
        <extensionPoint name="aiFeature"
                        interface="com.lihtdev.lingxicode.feature.AiFeature"
                        dynamic="true"/>
    </extensionPoints>

    <actions>
        <!-- 提交对话框消息区 toolbar 的「AI 生成」按钮 -->
        <action id="LingxiCode.GenerateCommitMessage"
                class="com.lihtdev.lingxicode.action.GenerateCommitMessageAction"
                text="action.generateCommitMessage.text"
                description="action.generateCommitMessage.description"
                icon="/icons/lingxicode.svg">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="first"/>
        </action>

        <!-- 编辑器右键「LingxiCode AI」功能组 -->
        <group id="LingxiCode.EditorGroup"
               class="com.lihtdev.lingxicode.action.LingxiCodeActionGroup"
               text="LingxiCode AI"
               description="LingxiCode AI features"
               popup="true"
               icon="/icons/lingxicode.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>

            <!-- 解释代码：选中代码块 / 光标所在类、方法、函数 -->
            <action id="LingxiCode.ExplainCode"
                    class="com.lihtdev.lingxicode.action.ExplainCodeAction"
                    text="action.explainCode.text"
                    description="action.explainCode.description"
                    icon="/icons/lingxicode.svg">
                <keyboard-shortcut keymap="$default" first-keystroke="alt L"/>
            </action>
        </group>
    </actions>
</idea-plugin>
