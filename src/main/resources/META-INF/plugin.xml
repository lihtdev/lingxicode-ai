<idea-plugin>
    <id>com.lihtdev.codesense</id>
    <name>CodeSense AI</name>
    <vendor>lihtdev</vendor>
    <description><![CDATA[
    CodeSense AI（灵犀码）— 面向开发者的 AI 能力集。<br/>
    当前功能：<br/>
    <ul>
        <li>AI 提交信息生成：在 Git 提交对话框一键根据代码变更生成 Conventional Commits 格式提交信息</li>
        <li>支持 OpenAI / DeepSeek / GLM / Kimi / MiniMax / Qwen / Xiaomi MIMO 等预设厂商及任意自定义 OpenAI 兼容端点</li>
    </ul>
    ]]></description>

    <!-- 仅依赖平台模块，全系列 JetBrains IDE 可用 -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 应用级设置持久化 -->
        <applicationService serviceImplementation="com.lihtdev.codesense.settings.AppSettings"/>
        <!-- 国际化资源束 -->
        <applicationService serviceImplementation="com.lihtdev.codesense.i18n.CodeSenseBundle"/>
        <!-- 设置页（Tools 下） -->
        <applicationConfigurable parentId="tools"
                                 id="codesense.settings"
                                 instance="com.lihtdev.codesense.settings.SettingsConfigurable"
                                 displayName="CodeSense AI"
                                 icon="/icons/codesense.svg"/>
        <!-- 通知组 -->
        <notificationGroup id="CodeSenseAI" displayType="BALLOON"/>
        <!-- 状态栏模型切换器 -->
        <statusBarWidgetFactory id="codesense.modelSwitcher"
                                implementation="com.lihtdev.codesense.ui.ModelSwitcherWidgetFactory"
                                order="after Encoding"/>
    </extensions>

    <!-- 预留的 AI 功能扩展点：后续新功能（如代码解释）经此注册 -->
    <extensionPoints>
        <extensionPoint name="aiFeature"
                        interface="com.lihtdev.codesense.feature.AiFeature"
                        dynamic="true"/>
    </extensionPoints>

    <actions>
        <!-- 提交对话框消息区 toolbar 的「AI 生成」按钮 -->
        <action id="CodeSense.GenerateCommitMessage"
                class="com.lihtdev.codesense.action.GenerateCommitMessageAction"
                text="AI Generate Commit Message"
                description="Use AI to generate a Conventional Commits message from code changes"
                icon="/icons/codesense.svg">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="first"/>
        </action>

        <!-- 编辑器右键预留功能组（v1 为空组，后续挂载代码解释等 AI 功能） -->
        <group id="CodeSense.EditorGroup"
               class="com.lihtdev.codesense.action.CodeSenseActionGroup"
               text="CodeSense AI"
               description="CodeSense AI features"
               popup="true"
               icon="/icons/codesense.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>